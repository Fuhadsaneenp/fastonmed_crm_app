{
  "name": "fastonmed-mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "sync": "cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "configure": "node scripts/configure.mjs",
    "sync:android": "cap sync android",
    "build:android": "npm run sync:android && cd android && ./gradlew assembleDebug",
    "release:android": "npm run configure && npm run sync:android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/ios": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  }
}
